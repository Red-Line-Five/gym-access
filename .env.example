# Copy to .env on the machine that runs the agent. NEVER commit .env.

# --- Door device (agent + smoke test) -----------------------------------
HIK_URL=http://192.168.1.64
HIK_USER=admin
HIK_PASS=change-me

# --- Agent <-> database --------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# service_role key: bypasses RLS. Only on the gym PC / server, never in a browser.
SUPABASE_SERVICE_KEY=change-me
GYM_ID=00000000-0000-0000-0000-000000000000
POLL_SECONDS=5

# --- WhatsApp Cloud API (server side) ------------------------------------
WA_PHONE_NUMBER_ID=
WA_TOKEN=
WA_APP_SECRET=
